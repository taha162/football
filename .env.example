# Copy to .env.local and fill in. Never commit real values.
# For the local Supabase stack, `pnpm db:start` prints the URL and keys
# (or run `npx supabase status -o env`).

# --- Public (inlined into the browser bundle) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Absolute origin of the app; used for auth e-mail redirects and metadata.
# On Vercel set it for Production only (your domain); previews then fall back
# to their own deployment URL automatically. See DEPLOYMENT.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Maps: "none" (default; shows address + "open in maps" links only) or "mapbox".
NEXT_PUBLIC_MAP_PROVIDER=none
# Required only when NEXT_PUBLIC_MAP_PROVIDER=mapbox. Use a URL-restricted public token.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Server only (never prefix with NEXT_PUBLIC_) ---------------------------
# Used only by /api/cron and the operator admin bootstrap script.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer secret for GET /api/cron (at least 16 characters, random).
CRON_SECRET=

# --- WhatsApp verification (optional; see DEPLOYMENT.md section 6) ----------
# Users send a code from their WhatsApp to this number; Meta's WhatsApp Cloud
# API delivers it to /api/whatsapp/webhook. Leave empty to hide the option.
# International format, digits only (e.g. 9647701234567).
WHATSAPP_NUMBER=
# Any random string; the same value goes into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Meta app secret (server only) used to check webhook signatures.
WHATSAPP_APP_SECRET=
# Optional: send a short "verified" reply (free inside the 24h service window).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=v23.0

# --- Tests (optional) -------------------------------------------------------
# Postgres URL for the DB integration tests (defaults to the local stack).
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# E2E_BASE_URL=http://localhost:3000
# E2E_SERVER_COMMAND="pnpm start"
