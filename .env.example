# Copy to .env.local and fill in. Never commit real values.
# For the local Supabase stack, `pnpm db:start` prints the URL and keys
# (or run `npx supabase status -o env`).

# --- Public (inlined into the browser bundle) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Absolute origin of the app; used for auth e-mail redirects and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Maps: "none" (default; shows address + "open in maps" links only) or "mapbox".
NEXT_PUBLIC_MAP_PROVIDER=none
# Required only when NEXT_PUBLIC_MAP_PROVIDER=mapbox. Use a URL-restricted public token.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Server only (never prefix with NEXT_PUBLIC_) ---------------------------
# Used only by /api/cron and the operator admin bootstrap script.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer secret for GET /api/cron (at least 16 characters, random).
CRON_SECRET=

# --- Tests (optional) -------------------------------------------------------
# Postgres URL for the DB integration tests (defaults to the local stack).
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# E2E_BASE_URL=http://localhost:3000
# E2E_SERVER_COMMAND="pnpm start"
