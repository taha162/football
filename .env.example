# Copy to .env.local and fill in. Never commit real values.
# For the local Supabase stack, `pnpm db:start` prints the URL and keys
# (or run `npx supabase status -o env`).

# --- Public (inlined into the browser bundle) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Absolute origin of the app; used for auth e-mail redirects and metadata.
# On Vercel set it for Production only (your domain); previews then fall back
# to their own deployment URL automatically. See DEPLOYMENT.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Maps: "none" (default; shows address + "open in maps" links only) or "mapbox".
NEXT_PUBLIC_MAP_PROVIDER=none
# Required only when NEXT_PUBLIC_MAP_PROVIDER=mapbox. Use a URL-restricted public token.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Server only (never prefix with NEXT_PUBLIC_) ---------------------------
# Used only by /api/cron and the operator admin bootstrap script.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer secret for GET /api/cron and POST /api/push (at least 16 characters, random).
CRON_SECRET=

# --- Phone notifications from the app (optional; DEPLOYMENT.md section 22) --
# Android: the Firebase service account's JSON (or that JSON in base64). Secret.
FIREBASE_SERVICE_ACCOUNT=
# iPhone: an APNs key from the Apple Developer account (.p8 text or base64). Secret.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
# The app's id (default com.almalab.app); APNS_ENV=sandbox only for builds run from Xcode.
APNS_BUNDLE_ID=
APNS_ENV=

# --- WhatsApp (optional; see DEPLOYMENT.md section 15) ----------------------
# Sign-up and password recovery by sending a code from WhatsApp, booking
# messages, and promotions to people who opted in, all through the platform's
# own number and the bot in whatsapp-bot/ (Baileys, no Meta account). Leave
# empty to hide the option. Apply supabase/migrations/…0028 first.
# Shared with the bot: at least 32 random characters (openssl rand -hex 32). Secret.
WHATSAPP_BOT_SECRET=
# The platform's WhatsApp number with its country code (e.g. 9647701234567).
WHATSAPP_BOT_NUMBER=
# Where the bot listens, https (e.g. https://al-malab-bot.up.railway.app).
# Without it verification still works, but nothing is sent from the site.
WHATSAPP_BOT_URL=

# --- Tests (optional) -------------------------------------------------------
# Postgres URL for the DB integration tests (defaults to the local stack).
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# E2E_BASE_URL=http://localhost:3000
# E2E_SERVER_COMMAND="pnpm start"
